/* ========================================
   Voice Base — 全局基础样式
   ======================================== */

/* 全局字体 */
QWidget {
    font-family: {{FONT_FAMILY}};
}

/* ── 滚动条（全局） ── */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::handle:vertical:pressed {
    background: {{TIANYI_BLUE_DEEP}};
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 24px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ── 工具提示 ── */
QToolTip {
    background-color: {{CARD}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{TIANYI_BLUE}};
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
}

/* ── 右键菜单 ── */
QMenu {
    background-color: {{CARD}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    color: {{TEXT_PRIMARY}};
    padding: 6px 24px;
    border-radius: 4px;
    font-size: 14px;
}
QMenu::item:selected {
    background-color: {{TIANYI_BLUE_GLOW}};
    color: {{TEXT_PRIMARY}};
}
QMenu::separator {
    height: 1px;
    background: {{BORDER}};
    margin: 4px 8px;
}

/* ── 文字选中色 ── */
QWidget {
    selection-background-color: {{TIANYI_BLUE_LIGHT}};
    selection-color: {{TEXT_PRIMARY}};
}
