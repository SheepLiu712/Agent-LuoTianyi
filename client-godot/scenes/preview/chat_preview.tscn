tooltip_text = "选择角色表情"

[node name="ChatCard" type="PanelContainer" parent="Split"]
custom_minimum_size = Vector2(410, 0)
size_flags_horizontal = 3
theme_type_variation = &"ChatSurface"

[node name="Margin" type="MarginContainer" parent="Split/ChatCard"]
theme_override_constants/margin_left = 24
