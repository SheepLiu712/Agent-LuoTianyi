[node name="ChatPreview" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")
files = ExtResource("isolation_files")
settings = ExtResource("isolation_settings")
runtime = ExtResource("isolation_runtime")
window_system = ExtResource("isolation_window_system")
geometry_store = ExtResource("isolation_geometry_store")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.9607843, 0.972549, 0.9803922, 1)

[node name="Split" type="HSplitContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8

[node name="AvatarPanel" parent="Split" instance=ExtResource("3_avatar")]
unique_name_in_owner = true
custom_minimum_size = Vector2(290, 0)
layout_mode = 2

[node name="Header" type="VBoxContainer" parent="Split/AvatarPanel"]
offset_left = 24.0
offset_top = 24.0
offset_right = 24.0
offset_bottom = 24.0
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Name" type="Label" parent="Split/AvatarPanel/Header"]
theme_override_colors/font_color = Color(0.1882353, 0.3019608, 0.3764706, 1)
theme_override_font_sizes/font_size = 25
text = "洛天依"

[node name="Subtitle" type="Label" parent="Split/AvatarPanel/Header"]
theme_override_colors/font_color = Color(0.3215686, 0.4196078, 0.4901961, 1)
theme_override_font_sizes/font_size = 13
text = "把平凡的日子，慢慢说给我听。"

[node name="Expressions" parent="Split/AvatarPanel/Header" instance=ExtResource("5_dropdown")]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
