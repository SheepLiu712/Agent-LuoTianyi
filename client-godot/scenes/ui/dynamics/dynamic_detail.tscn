[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/dynamic_detail.gd" id="1_detail"]
[ext_resource type="Theme" path="res://theme/app_theme.tres" id="2_theme"]
[ext_resource type="Shader" path="res://assets/ui/round_avatar.gdshader" id="3_shader"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_avatar"]
shader = ExtResource("3_shader")

[node name="DynamicDetail" type="ScrollContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme = ExtResource("2_theme")
horizontal_scroll_mode = 0
script = ExtResource("1_detail")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Column" type="VBoxContainer" parent="Margin"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Avatar" type="TextureRect" parent="Margin/Column/Header"]
unique_name_in_owner = true
material = SubResource("ShaderMaterial_avatar")
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
size_flags_vertical = 0
expand_mode = 1
stretch_mode = 5

[node name="Identity" type="VBoxContainer" parent="Margin/Column/Header"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Author" type="Label" parent="Margin/Column/Header/Identity"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.1882353, 0.27058825, 0.3254902, 1)
theme_override_font_sizes/font_size = 18

[node name="CreatedAt" type="Label" parent="Margin/Column/Header/Identity"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.3764706, 0.49803922, 0.5529412, 1)
theme_override_font_sizes/font_size = 12

[node name="Body" type="RichTextLabel" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
fit_content = true
scroll_active = false
selection_enabled = true

[node name="Notice" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SettingsHelpText"
text = "此动态不可评论。"

[node name="CommentSep" type="HSeparator" parent="Margin/Column"]
layout_mode = 2

[node name="CommentsHeading" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_type_variation = &"SettingsCardTitle"
text = "评论"

[node name="Comments" type="VBoxContainer" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 16

[node name="CommentDraft" type="TextEdit" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 90)
layout_mode = 2
theme_type_variation = &"DynamicInput"
placeholder_text = "写下你的留言…"
wrap_mode = 1

[node name="Send" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 8
theme_type_variation = &"PrimaryButton"
text = "发送评论"

[node name="ReplyBox" type="VBoxContainer" parent="Margin/Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="ReplyLabel" type="Label" parent="Margin/Column/ReplyBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SettingsHelpText"

[node name="ReplyDraft" type="TextEdit" parent="Margin/Column/ReplyBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 90)
layout_mode = 2
theme_type_variation = &"DynamicInput"
placeholder_text = "写下回复…"
wrap_mode = 1

[node name="Actions" type="HBoxContainer" parent="Margin/Column/ReplyBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CancelReply" type="Button" parent="Margin/Column/ReplyBox/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_type_variation = &"SettingsButton"
text = "取消回复对象"

[node name="ReplySend" type="Button" parent="Margin/Column/ReplyBox/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "发送回复"

[node name="Status" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
autowrap_mode = 3
