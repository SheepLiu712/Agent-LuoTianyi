grow_vertical = 2
mouse_filter = 0
color = Color(0.3, 0.36, 0.42, 1)
material = ExtResource("4_material")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0

[node name="Panel" type="PanelContainer" parent="Center"]
unique_name_in_owner = true
custom_minimum_size = Vector2(560, 400)
layout_mode = 2
theme_type_variation = &"DialogSurface"

[node name="Column" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Center/Panel/Column"]
layout_mode = 2

[node name="Title" type="Label" parent="Center/Panel/Column/Header"]
