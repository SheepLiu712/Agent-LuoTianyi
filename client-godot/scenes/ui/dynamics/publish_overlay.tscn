[ext_resource type="PackedScene" path="res://scenes/ui/components/decision_dialog.tscn" id="5_decision"]

[node name="PublishOverlay" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
