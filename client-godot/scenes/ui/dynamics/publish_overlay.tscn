wrap_mode = 1

[node name="PublishStatus" type="Label" parent="Center/Panel/Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"SettingsHelpText"
autowrap_mode = 3

[node name="Actions" type="HBoxContainer" parent="Center/Panel/Column"]
layout_mode = 2
