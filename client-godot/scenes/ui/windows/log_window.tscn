[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/log_window.gd" id="1_script"]
[ext_resource type="Theme" path="res://theme/app_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/unified_dropdown.tscn" id="3_dropdown"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/window_chrome.tscn" id="window_chrome"]
[ext_resource type="Resource" path="res://resources/platform/input.tres" id="isolation_input_service"]
[ext_resource type="Resource" path="res://resources/platform/files.tres" id="isolation_files"]

[sub_resource type="SystemFont" id="SystemFont_mono"]
font_names = PackedStringArray("Cascadia Mono", "Consolas", "Microsoft YaHei UI")

[node name="LogWindow" type="Window"]
size = Vector2i(960, 620)
visible = false
transient = false
min_size = Vector2i(660, 400)
force_native = true
theme = ExtResource("2_theme")
script = ExtResource("1_script")
input_service = ExtResource("isolation_input_service")
files = ExtResource("isolation_files")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"WindowShellSurface"

[node name="Column" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Filters" type="HFlowContainer" parent="Panel/Column"]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="RunsDropdown" parent="Panel/Column/Filters" instance=ExtResource("3_dropdown")]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 40)
layout_mode = 2
size_flags_horizontal = 3

[node name="CategoryDropdown" parent="Panel/Column/Filters" instance=ExtResource("3_dropdown")]
unique_name_in_owner = true
layout_mode = 2

[node name="LevelDropdown" parent="Panel/Column/Filters" instance=ExtResource("3_dropdown")]
unique_name_in_owner = true
layout_mode = 2

[node name="ModuleDropdown" parent="Panel/Column/Filters" instance=ExtResource("3_dropdown")]
unique_name_in_owner = true
layout_mode = 2

[node name="OriginDropdown" parent="Panel/Column/Filters" instance=ExtResource("3_dropdown")]
unique_name_in_owner = true
layout_mode = 2

[node name="Search" type="LineEdit" parent="Panel/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
placeholder_text = "搜索时间、活动或错误码"

[node name="Text" type="RichTextLabel" parent="Panel/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"TerminalSurface"
theme_override_colors/default_color = Color(0.8392157, 0.8980392, 0.93333334, 1)
theme_override_fonts/normal_font = SubResource("SystemFont_mono")
theme_override_font_sizes/normal_font_size = 14
selection_enabled = true

[node name="Actions" type="HBoxContainer" parent="Panel/Column"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Follow" type="CheckBox" parent="Panel/Column/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
button_pressed = true
text = "跟随最新"

[node name="CopyButton" type="Button" parent="Panel/Column/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_type_variation = &"SettingsButton"
text = "复制显示记录"

[node name="ExportButton" type="Button" parent="Panel/Column/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_type_variation = &"SettingsButton"
text = "导出完整诊断 ZIP"

[node name="StatusBanner" type="PanelContainer" parent="Panel/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatusBannerSurface"

[node name="Status" type="Label" parent="Panel/Column/StatusBanner"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
autowrap_mode = 3

[node name="Picker" type="FileDialog" parent="."]
unique_name_in_owner = true
file_mode = 4
access = 2
filters = PackedStringArray("*.zip ; ZIP 诊断包")
use_native_dialog = true

[node name="Chrome" parent="." instance=ExtResource("window_chrome")]
unique_name_in_owner = true
