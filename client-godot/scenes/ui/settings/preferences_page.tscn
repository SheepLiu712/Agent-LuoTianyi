[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/preferences_page.gd" id="1_preferences"]
[ext_resource type="Theme" path="res://theme/app_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/unified_dropdown.tscn" id="3_dropdown"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/toast_overlay.tscn" id="4_toast"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/status_banner.tscn" id="5_banner"]

[node name="PreferencesPage" type="MarginContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme = ExtResource("2_theme")
script = ExtResource("1_preferences")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Column"]
layout_mode = 2
theme_type_variation = &"SettingsPageTitle"
text = "和天依相处的方式"

[node name="LoadErrorBanner" parent="Column" instance=ExtResource("5_banner")]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="RelationshipCard" type="PanelContainer" parent="Column"]
layout_mode = 2
theme_type_variation = &"SettingsCard"

[node name="Content" type="VBoxContainer" parent="Column/RelationshipCard"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Column/RelationshipCard/Content"]
layout_mode = 2
theme_type_variation = &"SettingsCardTitle"
text = "关系与表达"

[node name="RelationshipLabel" type="Label" parent="Column/RelationshipCard/Content"]
layout_mode = 2
theme_type_variation = &"SettingsFieldLabel"
text = "关系"

[node name="RelationshipPresets" parent="Column/RelationshipCard/Content" instance=ExtResource("3_dropdown")]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "选择关系预设"
placeholder = "请选择关系"

[node name="SpeakingStyleLabel" type="Label" parent="Column/RelationshipCard/Content"]
layout_mode = 2
theme_type_variation = &"SettingsFieldLabel"
text = "表达风格"

[node name="SpeakingStylePresets" parent="Column/RelationshipCard/Content" instance=ExtResource("3_dropdown")]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "选择表达风格预设"
placeholder = "请选择表达风格"

[node name="ContextCard" type="PanelContainer" parent="Column"]
layout_mode = 2
theme_type_variation = &"SettingsCard"

[node name="Content" type="VBoxContainer" parent="Column/ContextCard"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Column/ContextCard/Content"]
layout_mode = 2
theme_type_variation = &"SettingsCardTitle"
text = "补充设定"

[node name="PersonalityLabel" type="Label" parent="Column/ContextCard/Content"]
layout_mode = 2
theme_type_variation = &"SettingsFieldLabel"
text = "性格关键词"

[node name="PersonalityField" type="TextEdit" parent="Column/ContextCard/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
theme_type_variation = &"SettingsTextEdit"
placeholder_text = "用逗号、顿号或换行分隔"
wrap_mode = 1

[node name="CustomContextLabel" type="Label" parent="Column/ContextCard/Content"]
layout_mode = 2
theme_type_variation = &"SettingsFieldLabel"
text = "补充上下文"

[node name="CustomContextField" type="TextEdit" parent="Column/ContextCard/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
theme_type_variation = &"SettingsTextEdit"
placeholder_text = "想让天依了解的相处背景"
wrap_mode = 1

[node name="Toast" parent="." instance=ExtResource("4_toast")]
unique_name_in_owner = true
layout_mode = 2
