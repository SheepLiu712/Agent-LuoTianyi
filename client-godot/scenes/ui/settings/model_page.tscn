[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/model_page.gd" id="1_model"]
[ext_resource type="Theme" path="res://theme/app_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/decision_dialog.tscn" id="3_decision"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/action_refresh.svg" id="refresh_icon"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/ui_lock.svg" id="lock_icon"]

[node name="ModelPage" type="MarginContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme = ExtResource("2_theme")
script = ExtResource("1_model")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Column/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.121569, 0.2, 0.25098, 1)
theme_override_font_sizes/font_size = 21
text = "模型配置"

[node name="RefreshTypes" type="Button" parent="Column/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
theme_type_variation = &"SettingsButton"
theme_override_constants/h_separation = 6
theme_override_constants/icon_max_width = 16
theme_override_font_sizes/font_size = 13
text = "刷新需求列表"
icon = ExtResource("refresh_icon")

[node name="SecurityRow" type="HBoxContainer" parent="Column"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LockIcon" type="TextureRect" parent="Column/SecurityRow"]
modulate = Color(0.133333, 0.545098, 0.329412, 1)
custom_minimum_size = Vector2(14, 14)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
texture = ExtResource("lock_icon")
expand_mode = 1
stretch_mode = 5

[node name="Description" type="Label" parent="Column/SecurityRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.247059, 0.333333, 0.388235, 1)
theme_override_font_sizes/font_size = 12
text = "API Key 仅保存在本机，不会上传到服务器。"
autowrap_mode = 3

[node name="Status" type="Label" parent="Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"SettingsHelpText"
autowrap_mode = 3

[node name="Cards" type="VBoxContainer" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="PlainDialog" parent="." instance=ExtResource("3_decision")]
unique_name_in_owner = true
title = "密钥保护失败"
dialog_text = "Windows 未能保护 API Key。是否明确选择在本机以明文保存？默认取消保存。"
ok_button_text = "明文保存"
cancel_button_text = "取消保存"

[node name="TestDialog" parent="." instance=ExtResource("3_decision")]
unique_name_in_owner = true
title = "测试可能消耗供应商额度"
dialog_text = "将使用当前草稿发送一次固定短输入，不发送聊天历史。成功仅表示本次请求可用。"
cancel_button_text = "取消"
