[node name="UnsavedDialog" parent="." instance=ExtResource("Decision")]
unique_name_in_owner = true
destructive_action = true
show_save = true
title = "设置尚未保存"
dialog_text = "可以保存全部修改后关闭，或放弃本窗口尚未保存的修改。"
