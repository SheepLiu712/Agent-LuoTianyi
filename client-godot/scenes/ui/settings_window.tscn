theme_type_variation = &"SettingsNavRail"

[node name="NavColumn" type="VBoxContainer" parent="Body/Column/PagesArea/Pages/Sidebar/NavMargin/NavRow"]
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="ProfileTab" type="Button" parent="Body/Column/PagesArea/Pages/Sidebar/NavMargin/NavRow/NavColumn"]
unique_name_in_owner = true
theme_type_variation = &"SettingsNavItem"
text = "个人资料"
toggle_mode = true
button_group = SubResource("SettingsTabs")
custom_minimum_size = Vector2(0, 40)

[node name="PreferencesTab" type="Button" parent="Body/Column/PagesArea/Pages/Sidebar/NavMargin/NavRow/NavColumn"]
unique_name_in_owner = true
theme_type_variation = &"SettingsNavItem"
text = "相处模式"
