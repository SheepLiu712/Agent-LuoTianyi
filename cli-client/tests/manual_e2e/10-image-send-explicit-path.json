{
  "actions": [
    {
      "action": "session.connect",
      "params": {
        "base_url": "https://example.invalid",
        "username": "cli_e2e_user",
        "password": "<redacted-password>",
        "timeout": 15
      }
    },
    {
      "action": "image.send",
      "params": {
        "path": "<TEMP>\\cli_e2e_image.png",
        "ack_timeout": 20
      }
    },
    {
      "action": "reply.wait",
      "params": {
        "timeout": 180,
        "non_empty": true
      }
    }
  ],
  "on_failure": "stop_side_effects"
}
