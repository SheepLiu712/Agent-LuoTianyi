[node name="ModelLabel" type="Label" parent="Margin/Scroll/Column"]
theme_override_colors/font_color = Color(0.20392157, 0.29803923, 0.34901962, 1)
theme_override_font_sizes/font_size = 14
text = "模型名称"

[node name="ModelName" type="LineEdit" parent="Margin/Scroll/Column"]
unique_name_in_owner = true

[node name="Json" type="CheckBox" parent="Margin/Scroll/Column"]
unique_name_in_owner = true
