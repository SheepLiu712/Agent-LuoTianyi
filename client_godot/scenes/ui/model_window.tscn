[node name="Thinking" type="CheckBox" parent="Margin/Scroll/Column"]
unique_name_in_owner = true
text = "声明支持 thinking"

[node name="ParamsLabel" type="Label" parent="Margin/Scroll/Column"]
theme_override_colors/font_color = Color(0.20392157, 0.29803923, 0.34901962, 1)
theme_override_font_sizes/font_size = 14
text = "高级 JSON 参数（非流式）"

[node name="Params" type="TextEdit" parent="Margin/Scroll/Column"]
