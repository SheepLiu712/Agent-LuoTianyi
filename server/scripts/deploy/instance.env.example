# systemd EnvironmentFile; use absolute paths and one file per instance.
AGENTLUO_CONFIG_DIR=/data/services/agentluo-test/config
AGENTLUO_DATA_DIR=/data/services/agentluo-test/data
AGENTLUO_RUNTIME_DIR=/data/services/agentluo-test/runtime
AGENTLUO_ASSET_DIR=/data/apps/agentluo/assets/production-baseline-20261110
# AGENTLUO_RESOURCE_DIR defaults to this release's res directory.
SERVER_HOST=127.0.0.1
# The port is selected from config.json (is_debug + server.debug_port/production_port).
